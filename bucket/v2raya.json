{
    "version": "2.5.13",
    "description": "v2rayA. A web GUI client for its own Xray-based core, supporting VMess, VLESS, Shadowsocks, Trojan, TUIC, Juicity and AnyTLS protocols.",
    "homepage": "https://github.com/v2rayA/v2raya",
    "license": {
        "identifier": "AGPL-3.0-only",
        "url": "https://github.com/v2rayA/v2rayA/raw/master/LICENSE"
    },
    "depends": "wintun-dll",
    "suggest": {
        "v2ray-rules-dat": "v2raya/v2ray-rules-dat"
    },
    "notes": [
        "Start v2rayA with Windows by running: 'reg import \"$(scoop prefix v2raya)\\add-startup.reg\".'",
        "The 'v2raya' shim runs v2rayA in lite mode (system proxy, no admin); run 'v2rayaWin' elevated to use the TUN mode."
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/v2rayA/v2rayA/releases/download/v2.5.13/v2raya_windows_x64_2.5.13.exe#/v2raya.exe",
                "https://github.com/v2rayA/v2rayA/releases/download/v2.5.13/v2raya_core_windows_x64_2.5.13.exe#/v2raya_core.exe"
            ],
            "hash": [
                "88a91c39c519d33dfade0fd9ea5354e0ff10372debf65ef35454dcda0073d746",
                "1994b1281c647654604ddc37c19bfba487cfc741d9a3099331009579391abcfb"
            ]
        },
        "arm64": {
            "url": [
                "https://github.com/v2rayA/v2rayA/releases/download/v2.5.13/v2raya_windows_arm64_2.5.13.exe#/v2raya.exe",
                "https://github.com/v2rayA/v2rayA/releases/download/v2.5.13/v2raya_core_windows_arm64_2.5.13.exe#/v2raya_core.exe"
            ],
            "hash": [
                "a4c9d4c7db5857af49d72593a9431be22bb6c4f74e3fde7a6203a1eefe1974b5",
                "ee253351a8b4aef465c85aaa120669f64bb607cf3a91499e6b46a0ce0b4207a8"
            ]
        }
    },
    "pre_install": [
        "# v2raya_core loads wintun.dll (needed for the TUN mode) from its own directory.",
        "Copy-Item \"$(scoop prefix wintun-dll)\\wintun.dll\" \"$dir\\wintun.dll\" -Force",
        "@('start-v2raya', 'stop-v2raya', 'reset-passwd-v2raya') | ForEach-Object {",
        "    Copy-Item \"$bucketsdir\\v2raya\\scripts\\v2raya\\$_.ps1\" \"$dir\\$_.ps1\"",
        "}",
        "$exepath = \"powershell -NoLogo -NoProfile -File $dir\\start-v2raya.ps1\".Replace('\\', '\\\\')",
        "@('add-startup', 'remove-startup') | ForEach-Object {",
        "    $content = Get-Content \"$bucketsdir\\v2raya\\scripts\\v2raya\\$_.reg\"",
        "    $content = $content.Replace('$exepath', $exepath)",
        "    if ($global) {",
        "       $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE')",
        "    }",
        "    $content | Set-Content -Path \"$dir\\$_.reg\" -Encoding Ascii",
        "}"
    ],
    "pre_uninstall": "stop-v2raya",
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { reg import \"$dir\\remove-startup.reg\" }"
    },
    "bin": [
        [
            "v2raya.exe",
            "v2raya",
            "--lite --config \"$dir\\config\""
        ],
        [
            "v2raya.exe",
            "v2rayaWin"
        ],
        "start-v2raya.ps1",
        "stop-v2raya.ps1",
        "reset-passwd-v2raya.ps1"
    ],
    "persist": "config",
    "checkver": {
        "url": "https://api.github.com/repos/v2rayA/v2raya/releases/latest",
        "regex": "v2raya_windows_x64_([\\d.]+).exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/v2rayA/v2rayA/releases/download/v$version/v2raya_windows_x64_$version.exe#/v2raya.exe",
                    "https://github.com/v2rayA/v2rayA/releases/download/v$version/v2raya_core_windows_x64_$version.exe#/v2raya_core.exe"
                ]
            },
            "arm64": {
                "url": [
                    "https://github.com/v2rayA/v2rayA/releases/download/v$version/v2raya_windows_arm64_$version.exe#/v2raya.exe",
                    "https://github.com/v2rayA/v2rayA/releases/download/v$version/v2raya_core_windows_arm64_$version.exe#/v2raya_core.exe"
                ]
            }
        }
    }
}
